    <None Include="Data\*.exr" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pbrt\Pbrt.csproj" />
    <!-- The command-line tools, which ToolsTests runs as separate processes. -->
    <ProjectReference Include="..\..\src\Pbrt.PlyTool\Pbrt.PlyTool.csproj" />
    <ProjectReference Include="..\..\src\Pbrt.NanoVDB2Pbrt\Pbrt.NanoVDB2Pbrt.csproj" />
    <ProjectReference Include="..\..\src\Pbrt.CyHair2Pbrt\Pbrt.CyHair2Pbrt.csproj" />
    <ProjectReference Include="..\..\src\Pbrt.PSpec\Pbrt.PSpec.csproj" />
    <ProjectReference Include="..\..\src\Pbrt.ImgTool\Pbrt.ImgTool.csproj" />
  </ItemGroup>

</Project>
